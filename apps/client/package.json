{
  "name": "@poker-champ/client",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:web": "node scripts/watch-tokens-web.cjs",
    "sync-tokens": "node scripts/sync-tokens-web.cjs",
    "build:web": "node scripts/sync-tokens-web.cjs && expo export --platform web",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:desktop": "pnpm build:web && pnpm tauri:build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@colyseus/sdk": "^0.17.26",
    "@poker-champ/realtime-contract": "workspace:*",
    "@poker-champ/sdk": "workspace:*",
    "expo": "~52.0.28",
    "expo-av": "~16.0.0",
    "expo-router": "~4.0.14",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "~2.0.1",
    "nativewind": "^4.1.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-css-interop": "^0.2.1",
    "react-native-mmkv": "^4.1.2",
    "react-native-nitro-modules": "^0.33.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-static-block": "^7.28.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-universe": "^13.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
