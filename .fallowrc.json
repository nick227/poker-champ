{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/client/index.ts",
    "apps/server/src/index.ts",
    "packages/*/src/index.ts"
  ],
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/coverage/**",
    "**/.expo/**",
    "**/build/**",
    "**/out/**",
    "**/artifacts/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/e2e/**",
    "**/scripts/**",
    "**/tools/**",
    "**/var/**",
    "**/.tmp-*.log",
    "**/*.log"
  ],
  "ignoreDependencies": [
    "@types/*",
    "typescript",
    "eslint",
    "vitest",
    "@vitest/*",
    "playwright",
    "@playwright/test",
    "prettier",
    "autoprefixer",
    "postcss",
    "tailwindcss",
    "expo",
    "expo-*",
    "react-native-*",
    "nativewind",
    "@babel/runtime",
    "react-native-css-interop",
    "react-native-worklets",
    "react-native-web",
    "@poker-champ/realtime-contract"
  ],
  "ignoreExports": [
    {
      "file": "apps/client/src/content/blog/articles/3bet-or-fold-stop-flat-calling.ts",
