  "duplicates": {
    "minOccurrences": 3,
    "ignore": [
      "**/dist/**",
      "**/node_modules/**",
      "**/coverage/**"
    ]
  },
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "circular-dependencies": "warn"
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30
  }
}
