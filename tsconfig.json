{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@poker-champ/db": ["packages/db/src/index.ts"],
      "@poker-champ/db/*": ["packages/db/src/*"]
    },
    "outDir": "dist",
    "rootDir": "./",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],

    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "useDefineForClassFields": false
    },
    "include": [
      "apps/server/src/**/*",
      "packages/db/src/**/*"
    ]
    }
