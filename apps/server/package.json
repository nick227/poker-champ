{
  "name": "@poker-champ/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p ../../tsconfig.json --noEmit --incremental false",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.config.ts",
    "test:run": "pnpm --dir ../.. exec vitest run --config vitest.config.ts",
    "test:round-state-parity": "node scripts/check-round-state-parity.mjs",
    "analyze:game-bugs": "node scripts/analyze-game-bugs-timeouts.mjs",
    "analyze:phase4": "node scripts/analyze-game-bugs-timeouts.mjs --max-issues 100",
    "analyze:phase4:gate": "node scripts/check-phase4-gate.mjs",
    "analyze:phase4:compare": "node scripts/compare-phase4-captures.mjs",
    "analyze:phase7:paths": "node scripts/analyze-phase7-paths.mjs",
    "analyze:phase7:dead-paths": "node scripts/analyze-phase7-dead-path-candidates.mjs",
    "analyze:phase7:dead-paths:triage": "node scripts/triage-phase7-dead-path-candidates.mjs",
    "lint": "eslint src --config ../../eslint.config.mjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.36",
    "@colyseus/schema": "^4.0.12",
    "@colyseus/ws-transport": "^0.17.9",
    "@poker-champ/realtime-contract": "workspace:*",
    "@poker-champ/db": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "p-limit": "^3.1.0",
    "pino": "^10.3.1",
    "poker-odds-calculator": "^0.4.0",
    "pokersolver": "^2.1.4",
    "stripe": "^20.4.0",
    "zod": "^4.3.6"
  }
}
