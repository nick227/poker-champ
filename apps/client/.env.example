EXPO_PUBLIC_WS_URL=ws://localhost:2567/ws
EXPO_PUBLIC_COLYSEUS_URL=ws://localhost:2567
EXPO_PUBLIC_REALTIME_TRANSPORT=colyseus
EXPO_PUBLIC_ENABLE_EXPERIMENTAL_WS=false

