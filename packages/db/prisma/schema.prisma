generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model PokerTable {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String  @default("POC Table")
  creatorId String?
  creator   User?   @relation("TableCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  maxSeats  Int     @default(9)
  showStats Boolean @default(true)

  players      PokerPlayer[]
  hands        Hand[]
  snapshotLogs TableSnapshotLog[]
  balances     PlayerBalance[]
  transactions BalanceTransaction[]
  interactions PlayerInteraction[]

  @@index([creatorId])
}

model PokerPlayer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  externalId String // userId or bot_*
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  tableId String
  table   PokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  displayName String @default("Player")
  seat        Int

  actions     HandAction[]
  payouts     HandPayout[]
  handsPlayed HandPlayer[]

  @@unique([tableId, externalId])
  @@index([tableId])
  @@index([userId])
}

model PlayerBalance {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tableId String
  table   PokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  // Link to User primarily now
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status String @default("ACTIVE") // ACTIVE | CASHED_OUT | ABANDONED

  balanceCents Int @default(0)

  @@unique([tableId, userId])
}

model BalanceTransaction {
  id        String   @id
  createdAt DateTime @default(now())

  tableId String?
  table   PokerTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Optional link to session if relevant
  // playerId  String?
  // player    PokerPlayer? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  handId String?
  hand   Hand?   @relation(fields: [handId], references: [id], onDelete: SetNull)

  amountCents Int

  // BUYIN, CASHOUT, BET, PAYOUT, REFUND, TOURNAMENT_ENTRY, TOURNAMENT_PAYOUT
  type String

  externalRef String? @unique

  metaJson Json?

  @@index([userId, createdAt])
  @@index([tableId, userId])
}

model Hand {
  id        String       @id
  createdAt DateTime     @default(now())
  endedAt   DateTime?
  players   HandPlayer[]
  tableId   String
  table     PokerTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)

  dealerSeat      Int
  smallBlindCents Int
  bigBlindCents   Int

  reason    String? // LAST_PLAYER | SHOWDOWN
  boardJson Json? // ["Ah","Kd","2c",...]

  actions      HandAction[]
  payouts      HandPayout[]
  snapshotLogs TableSnapshotLog[]
  txs          BalanceTransaction[]
  interactions PlayerInteraction[]
}

model HandPlayer {
  id     String @id
  handId String
  hand   Hand   @relation(fields: [handId], references: [id], onDelete: Cascade)

  playerId String
  player   PokerPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  seat               Int
  startingStackCents Int
  endingStackCents   Int?

  holeCardsJson Json? // ["As","Kd"] (stored for audit; encrypt later for prod)

  @@unique([handId, playerId])
  @@index([handId, seat])
}

model HandAction {
  id        String   @id
  createdAt DateTime @default(now())

  handId String
  hand   Hand   @relation(fields: [handId], references: [id], onDelete: Cascade)

  playerId String
  player   PokerPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  seat        Int
  actionIndex Int
  street      String // PREFLOP/FLOP/TURN/RIVER
  action      String // FOLD/CHECK/CALL/BET/RAISE/ALL_IN/AUTO_FOLD/AUTO_CHECK
  amountCents Int    @default(0)

  potBeforeCents Int @default(0)
  potAfterCents  Int @default(0)

  metaJson Json?

  @@unique([handId, actionIndex])
  @@index([handId, createdAt])
  @@index([handId, actionIndex])
}

model HandPayout {
  id        String   @id
  createdAt DateTime @default(now())

  handId String
  hand   Hand   @relation(fields: [handId], references: [id], onDelete: Cascade)

  playerId String
  player   PokerPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  payoutIndex Int
  amountCents Int

  @@unique([handId, payoutIndex])
  @@index([handId])
  @@index([handId, payoutIndex])
}

enum SnapshotLogReason {
  HAND_START
  ACTION_ACCEPTED
  STREET_TRANSITION
  POT_UPDATED
  SHOWDOWN
  HAND_END
  PLAYER_JOIN
  PLAYER_LEAVE
}

model TableSnapshotLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  tableId String
  table   PokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  handId String?
  hand   Hand?   @relation(fields: [handId], references: [id], onDelete: SetNull)

  snapshotId    String            @unique
  reason        SnapshotLogReason
  street        String
  payloadJson   Json
  payloadBytes  Int
  stateHash     String
  schemaVersion Int               @default(1)

  @@index([tableId, createdAt])
  @@index([tableId, handId, createdAt])
  @@index([tableId, reason, createdAt])
}

enum PlayerInteractionType {
  GIFT
  SIDE_BET
}

enum PlayerInteractionStatus {
  PENDING
  ACTIVE
  COMPLETED
  DECLINED
  CANCELLED
  EXPIRED
  VOIDED
}

// Shared persistence model for player-to-player Gifts and Side Bets (docs/GIFTS_AND_SIDE_BETS_DESIGN.md).
// A Gift goes straight to COMPLETED in one transaction. A Side Bet walks PENDING -> ACTIVE -> COMPLETED
// (or DECLINED/CANCELLED/EXPIRED/VOIDED). Only Gifts are implemented server-side so far (Phase 2); the
// side-bet fields (handId, winnerId, expiresAt, etc.) are included now so the schema doesn't need a second
// migration when side bets ship.
model PlayerInteraction {
  id          String                   @id @default(cuid())
  type        PlayerInteractionType
  status      PlayerInteractionStatus  @default(PENDING)
  catalogKey  String
  tableId     String
  handId      String?
  initiatorId String
  recipientId String
  stakeCents  Int                      @default(0)
  payoutCents Int?
  winnerId    String?
  metadata    Json?
  externalRef String                   @unique
  createdAt   DateTime                 @default(now())
  respondedAt DateTime?
  resolvedAt  DateTime?
  expiresAt   DateTime?

  table     PokerTable @relation(fields: [tableId], references: [id])
  hand      Hand?      @relation(fields: [handId], references: [id])
  initiator User       @relation("InteractionsInitiated", fields: [initiatorId], references: [id])
  recipient User       @relation("InteractionsReceived", fields: [recipientId], references: [id])

  @@index([tableId, status])
  @@index([recipientId, status])
  @@index([handId])
}

model LobbyChatMessage {
  id           String   @id
  scope        String   @default("lobby")
  createdAt    DateTime @default(now())
  senderUserId String
  senderName   String
  text         String

  @@index([scope, createdAt, id])
  @@index([scope, senderUserId, createdAt])
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  username           String?   @unique
  usernameNormalized String?   @unique
  passwordHash       String
  displayName        String
  role               UserRole  @default(USER)
  avatarUrl          String?
  avatarVersion      Int?
  avatarUpdatedAt    DateTime?

  // Trust & Safety
  isBanned   Boolean   @default(false)
  deletedAt  DateTime?
  trustLevel Int       @default(1) // 1=New, 2=Verified, 3=Trusted

  // Email verification (rung 1 of the trustLevel ladder — see docs/proposals/AUTH_IDENTITY_PROPOSAL.md)
  emailVerifiedAt DateTime?

  // Password reset (single-use token; only the hash is stored)
  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?

  // Email verification token (single-use; only the hash is stored)
  emailVerificationTokenHash      String?
  emailVerificationTokenExpiresAt DateTime?

  // Economy
  bankrollCents Int @default(1000000) // Central wallet

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions      UserSession[]
  playerHistory PokerPlayer[]

  // Economy
  balances             PlayerBalance[]
  transactions         BalanceTransaction[]
  registrations        TournamentRegistration[]
  createdTables        PokerTable[]             @relation("TableCreator")
  leaderboardSnapshots LeaderboardSnapshot[]
  lessonAttempts       LessonAttempt[]
  drillSessions        DrillSession[]
  conceptMastery       UserConceptMastery[]
  userAwards           UserAward[]
  curriculumProgress   UserCurriculumProgress?
  handCount            UserHandCount?
  tournamentStats      UserTournamentStats?
  tournamentResults    TournamentPlayerResult[]
  createdTournaments   Tournament[]             @relation("TournamentCreator")

  // Monetization
  membership Membership?

  // Admin audit trail
  adminLogsAsActor  AdminLog[] @relation("AdminLogActor")
  adminLogsAsTarget AdminLog[] @relation("AdminLogTarget")

  // Player interactions (gifts / side bets — docs/GIFTS_AND_SIDE_BETS_DESIGN.md)
  interactionsInitiated PlayerInteraction[] @relation("InteractionsInitiated")
  interactionsReceived  PlayerInteraction[] @relation("InteractionsReceived")

  @@index([usernameNormalized])
}

// Append-only audit trail for every admin-initiated action (ban, promote,
// role change, table close/kick, balance recovery run, etc). Rows are never
// updated or deleted by application code.
model AdminLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Admin user who performed the action.
  actorUserId String
  actor       User   @relation("AdminLogActor", fields: [actorUserId], references: [id])

  // BAN | UNBAN | PROMOTE | ROLE_CHANGE | SOFT_DELETE | RESTORE |
  // CREATE_ADMIN_USER | BALANCE_RECOVERY | TABLE_CLOSE | TABLE_KICK
  action String

  // Target user, when the action affects a specific user account.
  // Nullable because some actions (e.g. table close) target a table, not a user.
  targetUserId String?
  targetUser   User?   @relation("AdminLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  // Target table/room, when the action affects a live table rather than (or
  // in addition to) a user account.
  targetTableId String?

  // State snapshots for the affected fields, before and after the action.
  beforeJson Json?
  afterJson  Json?

  // Optional operator-supplied justification for the action.
  reason String?

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model LeaderboardSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  period          String
  category        String
  actorId         String // stable identity (user id or bot externalId / "bot:..."); not a FK
  actorType       String // "USER" | "BOT" — filter human-only or bot-only leaderboards
  userId          String? // FK to User when real user; null for bots
  user            User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userDisplayName String

  value            String
  valueNumerator   Int
  valueDenominator Int?
  handCount        Int      @default(0)
  rank             Int
  computedAt       DateTime
  isEmpty          Boolean  @default(false)

  @@unique([period, category, computedAt, rank])
  @@unique([period, category, computedAt, actorId])
  @@index([period, category, computedAt, rank])
  @@index([period, category, computedAt])
  @@index([userId, computedAt])
  @@index([actorId, computedAt])
  @@index([actorType])
}

model Tournament {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name   String
  status String @default("REGISTERING") // REGISTERING | LATE_REG | STARTING | RUNNING | FINISHED | ABANDONED | CANCELLED

  entryFeeCents  Int
  prizePoolCents Int @default(0)

  startTime DateTime

  maxPlayers         Int
  startingStackCents Int
  blindStructureId   String
  lateRegMinutes     Int @default(0)

  playFormat         String @default("FREEZEOUT") // FREEZEOUT | REBUY
  maxRebuysPerPlayer Int    @default(0)
  rebuyPeriodMinutes Int    @default(0)

  fillBotsAtStart Boolean @default(false)
  fillBotCount    Int?

  currentLevel Int       @default(1)
  nextLevelAt  DateTime?

  tableId    String?
  roomId     String?
  finishedAt DateTime?

  /// Hand-for-hand near the money bubble (MTT proposal Phase 4): true while every live table is
  /// finishing its current hand and holding before the next one, waiting for all tables to catch
  /// up so no table plays extra hands relative to another this close to the money.
  handForHandActive Boolean @default(false)

  createdByUserId String?
  createdBy       User?   @relation("TournamentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  registrations TournamentRegistration[]
  transactions  BalanceTransaction[]
  playerResults TournamentPlayerResult[]
  tables        TournamentTable[]

  @@index([createdByUserId])
}

/// Multi-table tournament (MTT) support. One row per physical table a Tournament spans.
/// A single-table tournament (the common case while maxPlayers stays capped) is just the
/// N=1 case: exactly one TournamentTable row with tableNumber=1. Additive-only; does not
/// replace Tournament.tableId/roomId, which remain deprecated convenience fields mirroring
/// table #1. See docs/proposals/MULTI_TABLE_TOURNAMENT_PROPOSAL.md.
model TournamentTable {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  tableNumber Int // 1-based, stable for the tournament's lifetime even after breaks
  tableId     String? // PokerTable.id once provisioned (mirrors Tournament.tableId today)
  roomId      String? // Colyseus room id once provisioned (mirrors Tournament.roomId today)
  status      String   @default("OPEN") // OPEN | BREAKING | CLOSED
  /// Hand-for-hand (MTT proposal Phase 4): this table finished its current hand and is holding,
  /// waiting for every other live OPEN table to also report ready before all are released together.
  handForHandReady Boolean @default(false)

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  registrations TournamentRegistration[]

  @@unique([tournamentId, tableNumber])
  @@index([tournamentId, status])
}

model TournamentPlayerResult {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  finishPlace  Int
  payoutCents  Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@index([userId])
}

model UserTournamentStats {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentsPlayed       Int      @default(0)
  tournamentWins          Int      @default(0)
  tournamentCashes        Int      @default(0)
  tournamentEarningsCents Int      @default(0)
  updatedAt               DateTime @updatedAt
}

model TournamentRegistration {
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  entryTxId String? // idempotent ref

  finishPlace  Int?
  eliminatedAt DateTime?
  rebuyPendingAt DateTime?

  isBot Boolean @default(false)

  tournamentTableId String?
  tournamentTable    TournamentTable? @relation(fields: [tournamentTableId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, userId])
  @@index([tournamentTableId])
}

model UserSession {
  id         String    @id // Token
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime

  @@index([userId])
}

enum TableSeatSessionState {
  SEATED_ACTIVE
  SEATED_SITTING_OUT
  LEFT
}

model Lesson {
  id                String   @id
  slug              String   @unique
  title             String
  description       String?  @db.Text
  moduleCode        String   @default("MODULE_A")
  recommendedOrder  Int      @default(999)
  role              String   @default("teaches")
  repeatable        Boolean  @default(false)
  curriculumVersion String?
  difficulty        String
  status            String   @default("DRAFT")
  estimatedMinutes  Int?
  version           Int      @default(1)
  tier              String?  @default("pro") // free | pro | elite
  applyCtaText      String? // lesson-specific apply-at-table CTA
  blogPostSlug      String? // optional related blog post (slug)
  replayHandId      String? // optional related replay hand id
  format            String   @default("STANDARD") // STANDARD | DRILL
  drillConfigJson   Json? // DRILL only: { drillType: DrillCategory, questionCount: number }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  steps         LessonStep[]
  attempts      LessonAttempt[]
  drillSessions DrillSession[]
}

model DrillSession {
  id            String    @id
  lessonId      String
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionsJson Json // server-only source of truth: full generated/curated question set incl. correctIndex
  status        String    @default("ACTIVE") // ACTIVE | COMPLETED
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId, lessonId, status])
}

model LessonStep {
  id              String   @id
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sequence        Int
  type            String
  snapshotVersion Int?
  snapshotJson    Json?
  gradingVersion  Int      @default(1)
  beforeMessage   String?  @db.Text
  questionText    String?  @db.Text
  followUpMessage String?  @db.Text
  gradingSpecJson Json?
  explanationJson Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  options      LessonStepOption[]
  concepts     LessonStepConcept[]
  attemptSteps LessonAttemptStep[]

  @@unique([lessonId, sequence])
  @@index([lessonId, sequence])
}

model LessonStepOption {
  id           String     @id
  stepId       String
  step         LessonStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  optionKey    String
  label        String
  valueJson    Json?
  displayOrder Int
  isCorrect    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([stepId, optionKey])
  @@index([stepId, displayOrder])
}

model LessonConcept {
  id          String   @id
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stepLinks LessonStepConcept[]
  mastery   UserConceptMastery[]
}

model LessonStepConcept {
  stepId    String
  step      LessonStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  conceptId String
  concept   LessonConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  weight    Float         @default(1)
  createdAt DateTime      @default(now())

  @@id([stepId, conceptId])
  @@index([conceptId])
}

model LessonAttempt {
  id               String    @id
  lessonId         String
  lesson           Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String    @default("IN_PROGRESS")
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  scorePct         Float?
  masteryDeltaJson Json?
  summaryJson      Json? // ghost lessons: { matchedProCount, totalDecisions, accuracyPercent }
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  steps LessonAttemptStep[]

  @@index([lessonId, userId, status])
  @@index([userId, completedAt])
}

model LessonAttemptStep {
  id                  String        @id
  attemptId           String
  attempt             LessonAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  stepId              String
  step                LessonStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  submittedAnswerJson Json
  isCorrect           Boolean
  feedbackJson        Json?
  submittedAt         DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([attemptId, stepId])
  @@index([attemptId, submittedAt])
}

model UserConceptMastery {
  id            String        @id
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptId     String
  concept       LessonConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  masteryScore  Float         @default(0)
  confidence    Float         @default(0)
  lastUpdatedAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, conceptId])
  @@index([conceptId])
}

model UserAward {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  awardId        String
  catalogVersion Int      @default(1)
  earnedAt       DateTime @default(now())
  lastEarnedAt   DateTime @default(now())
  count          Int      @default(1)
  reason         String   @db.Text
  contextType    String?
  contextId      String?
  contextJson    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, awardId])
  @@index([userId, lastEarnedAt])
}

model AwardGrantEvent {
  id         String   @id @default(cuid())
  userId     String
  awardId    String
  triggerKey String
  earnedAt   DateTime @default(now())

  @@unique([userId, awardId, triggerKey])
  @@index([userId, awardId, triggerKey])
}

model UserCurriculumProgress {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedLessonsCount Int      @default(0)
  updatedAt             DateTime @updatedAt
}

model UserHandCount {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  handsDealt Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model TableSeatSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tableId String
  userId  String
  seat    Int
  state   TableSeatSessionState @default(SEATED_ACTIVE)

  stackCentsSnapshot Int     @default(0)
  buyInCents         Int     @default(0)
  handIdSnapshot     String?

  disconnectAt  DateTime?
  lastSeenAt    DateTime  @default(now())
  reservedUntil DateTime?

  schemaVersion Int @default(1)

  @@unique([tableId, userId])
  @@index([tableId])
  @@index([tableId, state])
}

model BotStats {
  botId          String   @id
  handsPlayed    Int      @default(0)
  netCents       BigInt   @default(0)
  grossWonCents  BigInt   @default(0)
  grossLostCents BigInt   @default(0)
  updatedAt      DateTime @updatedAt
}

model Membership {
  id          String    @id @default(cuid())
  userId      String    @unique
  stripeId    String? // Stripe Customer ID
  type        String // "lifetime", "monthly", etc.
  status      String // "active", "cancelled", "expired"
  purchasedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model ContentAccess {
  id           String  @id @default(cuid())
  contentId    String // lesson, section, feature ID
  type         String // "lesson", "section", "feature"
  isPremium    Boolean @default(false)
  requiredTier String? // "lifetime", "premium", etc.

  @@unique([contentId, type])
}

// Durable dedup ledger for Stripe webhook events. Source of truth for "have we
// already processed this event" — replaces the in-memory Set that used to live
// in apps/server/src/http/webhooks/stripe.ts (not durable across restarts).
// Dedup uses an idempotent-insert pattern: attempt to create a row, and treat a
// unique-constraint violation on `eventId` as "already processed" (same pattern
// as LedgerService's applyTransaction / BalanceTransaction.externalRef).
model StripeEvent {
  id                  String    @id @default(cuid())
  eventId             String    @unique // Stripe event id, e.g. evt_...
  type                String
  status              String    @default("claimed") // "claimed" | "completed" | "failed"
  processingStartedAt DateTime  @default(now())
  completedAt         DateTime?
  processedAt         DateTime  @default(now())

  @@index([type])
  @@index([status, processingStartedAt])
}
