# Colyseus
PORT=2567

# Optional DB
# DATABASE_URL="mysql://user:pass@localhost:3306/poker"

# Feature flags
# ENABLE_LESSONS_V1=true
# EXPO_PUBLIC_ENABLE_LESSONS_V1=true

# --- Mailer (server) ---
# When all of SMTP_HOST/SMTP_PORT/MAIL_FROM are set, transactional emails (password reset,
# email verification) are sent via SMTP. Otherwise they are logged via ConsoleMailer (dev/test
# default — no external service required).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=changeme
# MAIL_FROM="Poker Champ <no-reply@example.com>"
# Base URL used to build password-reset / email-verification links.
# APP_URL=http://localhost:3000

# --- Stripe (server) ---
# Required for membership checkout (create session) and webhook verification.
# Tips do NOT need these on the client; payment is via Payment Link (see client vars).
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:3000/success
STRIPE_CANCEL_URL=http://localhost:3000/cancel

# --- Monetization (payment does NOT gate content by default; set to true when ready) ---
ENABLE_PAY_GATING=false
ENABLE_MEMBERSHIP_PURCHASE=false
FOUNDING_MEMBER_PRICING=true
PREMIUM_PRICE=200.00
# SPA path for "upgrade" redirect when content is gated (default /membership)
# FRONTEND_UPGRADE_PATH=/membership

# --- Client (Expo) ---
# Publishable key is safe to expose; used if you use Stripe.js/embedded checkout on client.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Tip Payment Link ID: create a one-time Payment Link in Stripe Dashboard (Products → Payment Links).
# The link URL is like https://buy.stripe.com/XXXXXXXX — use the XXXXXXXX part here.
# Tips work with only this + EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY; no STRIPE_SECRET_KEY or
# STRIPE_WEBHOOK_SECRET needed for accepting tips (Stripe processes payment; optional: webhook to log tips).
EXPO_PUBLIC_STRIPE_TIP_LINK_ID=
