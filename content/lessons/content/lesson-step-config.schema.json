{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poker-champ.local/schemas/lesson-step-config.schema.json",
  "title": "Lesson Step Config",
  "type": "object",
  "required": ["lessonId", "title", "version", "steps"],
  "properties": {
    "lessonId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "lessonType": { "type": "string", "enum": ["STANDALONE", "FULL_HAND_GHOST"] },
    "heroSeat": { "type": "integer", "minimum": 0 },
    "moduleCode": { "type": "string" },
    "recommendedOrder": { "type": "integer", "minimum": 1 },
    "targetAudience": { "type": "string" },
    "difficulty": { "type": "string" },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sequence", "type", "gradingVersion", "snapshotVersion"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sequence": { "type": "integer", "minimum": 1 },
          "type": { "enum": ["INFO_STEP", "MCQ_STEP", "ACTION_STEP"] },
          "snapshotVersion": { "type": "integer", "minimum": 1 },
          "snapshotPath": { "type": "string" },
          "gradingVersion": { "type": "integer", "minimum": 1 },
          "beforeInstructorMessage": { "type": "string" },
          "question": { "type": "string" },
          "followUpInstructorMessage": { "type": "string" },
          "gradingSpecJson": { "type": "object" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["optionKey", "label", "displayOrder"],
              "properties": {
                "optionKey": { "type": "string" },
                "label": { "type": "string" },
                "displayOrder": { "type": "integer", "minimum": 1 },
                "value": {}
              }
            }
          },
          "scenarioProviderKey": { "type": "string" },
          "evaluatorKey": { "type": "string" },
          "revealLayerKeys": {
            "type": "array",
            "items": { "type": "string" }
          },
          "continuationKey": { "type": ["string", "null"] },
          "runtimeConfigJson": { "type": "object" },
          "displayCategory": { "type": "string" }
        }
      }
    }
  }
}
