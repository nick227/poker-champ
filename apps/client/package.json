{
  "name": "@poker-champ/client",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "postinstall": "pnpm --filter @poker-champ/realtime-contract build",
    "add-expo": "expo install --pnpm",
    "dev": "expo start",
    "dev:web": "node scripts/watch-tokens-web.cjs",
    "dev:web:clear": "expo start --web --clear --port 8081",
    "sync-tokens": "node scripts/sync-tokens-web.cjs",
    "build:web": "node scripts/sync-tokens-web.cjs && expo export --platform web --output-dir dist && node scripts/normalize-vector-icon-font-paths.cjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:voice": "vitest run src/voice/sdk/voice.webrtc-stun.test.ts",
    "e2e": "node node_modules/@playwright/test/cli.js test",
    "e2e:stack": "node node_modules/@playwright/test/cli.js test e2e/two-player-stack-consistency.spec.ts",
    "e2e:rejoin-buyin-override": "node node_modules/@playwright/test/cli.js test e2e/rejoin-buyin-override.spec.ts",
    "e2e:lessons": "node node_modules/@playwright/test/cli.js test e2e/lessons-instructor-loop.spec.ts",
    "e2e:lessons:canonical": "node node_modules/@playwright/test/cli.js test e2e/lessons-canonical-runtime.spec.ts",
    "e2e:lessons:canonical:clean": "set CI=1&& node node_modules/@playwright/test/cli.js test e2e/lessons-canonical-runtime.spec.ts",
    "e2e:stack:ci": "set CI=1&& node node_modules/@playwright/test/cli.js test e2e/two-player-stack-consistency.spec.ts",
    "e2e:churn": "node node_modules/@playwright/test/cli.js test e2e/churn-seat-dealin.spec.ts",
    "e2e:auth-guard": "node node_modules/@playwright/test/cli.js test e2e/auth-guard-settings.spec.ts e2e/auth-guard-table.spec.ts",
    "e2e:auth-guard:table": "node node_modules/@playwright/test/cli.js test e2e/auth-guard-table.spec.ts",
    "e2e:backgrounds": "node node_modules/@playwright/test/cli.js test e2e/app-backgrounds.spec.ts",
    "e2e:ui": "node node_modules/@playwright/test/cli.js test --ui",
    "e2e:install": "node node_modules/@playwright/test/cli.js install chromium",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ui:buttons:check": "node scripts/check-button-style-drift.mjs",
    "lint": "eslint .",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:desktop": "pnpm build:web && pnpm tauri:build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@colyseus/sdk": "^0.17.26",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@poker-champ/realtime-contract": "workspace:*",
    "@poker-champ/sdk": "workspace:*",
    "@react-navigation/native": "^7.0.14",
    "expo": "~52.0.28",
    "expo-asset": "~11.0.3",
    "expo-av": "~15.0.2",
    "expo-clipboard": "~7.0.1",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.6",
    "expo-router": "~4.0.14",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "nativewind": "^4.1.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-css-interop": "^0.2.1",
    "react-native-mmkv": "^4.1.2",
    "react-native-nitro-modules": "^0.33.9",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "react-native-worklets": "~0.7.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-static-block": "^7.28.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
