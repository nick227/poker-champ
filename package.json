{
  "name": "poker-client-scaffold",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "engines": {
    "node": ">=18 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "expo-font": "~13.0.4"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "9"
      }
    }
  },
  "scripts": {
    "dev:web": "pnpm -C apps/client dev:web",
    "dev": "pnpm -C apps/client dev",
    "build": "pnpm --filter @poker-champ/realtime-contract build && node scripts/retry-prisma-generate.mjs && tsc -p tsconfig.json",
    "preflight:client": "pnpm --filter @poker-champ/realtime-contract build && pnpm sdk:check && pnpm api:shapes:check && pnpm -C apps/client typecheck && pnpm -C apps/client lint && pnpm test:client && pnpm test:client:money-safety",
    "preflight:client:ci": "pnpm preflight:client",
    "build:web": "pnpm --filter @poker-champ/realtime-contract build && pnpm -C apps/client build:web",
    "build:client:all": "node scripts/build-all.mjs",
    "build:android": "pnpm -C apps/client build:android",
    "build:ios": "pnpm -C apps/client build:ios",
    "build:desktop": "pnpm -C apps/client build:desktop",
    "test:client": "pnpm -C apps/client test:run",
    "test:voice": "pnpm -C apps/client test:voice",
    "test:client:money-safety": "pnpm --prefix apps/client exec vitest run src/components/domain/table/table.adapter.money.test.ts",
    "test:client:lessons": "pnpm --prefix apps/client exec vitest run src/features/lessons/useLessonSession.test.ts",
    "test:client:e2e:stack": "pnpm -C apps/client e2e:stack",
    "test:client:e2e:stack:ci": "pnpm -C apps/client e2e:stack:ci",
    "test:client:e2e:churn": "pnpm -C apps/client e2e:churn",
    "test:client:e2e:lessons:canonical": "pnpm -C apps/client e2e:lessons:canonical",
    "test:server:history": "vitest run apps/server/src/http/__tests__/HandHistoryRouter.overview-and-hands.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:awards": "vitest run --config vitest.awards.config.ts --coverage",
    "test:server:lessons": "vitest run apps/server/src/http/__tests__/LessonsRouter.test.ts",
    "test:server:join": "vitest run apps/server/src/rooms/table-join.guard.test.ts",
    "test:server:broadcast": "vitest run apps/server/src/rooms/table-action-broadcast.test.ts",
    "test:server:money-safety": "vitest run apps/server/src/engine/dealer/services/settlement-service.money-safety.test.ts apps/server/src/engine/dealer/services/fold-path-equivalence.test.ts",
    "test:server:money-invariants": "vitest run apps/server/src/engine/money-invariants.test.ts apps/server/src/engine/hand-money-invariant.test.ts",
    "test:server:fuzz:ci": "vitest run apps/server/src/tests/integration/dealer.fuzz.invariants.ci.test.ts",
    "test:server:churn:matrix": "vitest run apps/server/src/engine/hand-end-fold-detection.regression.test.ts apps/server/src/tests/integration/multiplayer.churn.matrix.test.ts apps/server/src/engine/dealer.auto-action-warning.regression.test.ts",
    "test:server:churn:integration": "vitest run apps/server/src/tests/integration/table-multiplayer-churn.integration.test.ts",
    "test:server:bot:heatmap": "vitest run apps/server/src/engine/bots/brains/tight_aggressive/tight-aggressive-axis-heatmap.test.ts",
    "test:server:bot:heatmap:update": "set UPDATE_HEATMAP=1&& vitest run apps/server/src/engine/bots/brains/tight_aggressive/tight-aggressive-axis-heatmap.test.ts",
    "test:server:bot:heatmap:assert": "set HEATMAP_ASSERT=1&& vitest run apps/server/src/engine/bots/brains/tight_aggressive/tight-aggressive-axis-heatmap.test.ts",
    "test:server:bot:heatmap:profiles": "vitest run apps/server/src/engine/bots/brains/passive/tight-passive-heatmap.test.ts apps/server/src/engine/bots/brains/aggressive/loose-aggressive-heatmap.test.ts apps/server/src/engine/bots/brains/passive/loose-passive-heatmap.test.ts",
    "test:server:bot:heatmap:profiles:update": "set UPDATE_HEATMAP=1&& vitest run apps/server/src/engine/bots/brains/passive/tight-passive-heatmap.test.ts apps/server/src/engine/bots/brains/aggressive/loose-aggressive-heatmap.test.ts apps/server/src/engine/bots/brains/passive/loose-passive-heatmap.test.ts",
    "test:server:bot:heatmap:profiles:assert": "set HEATMAP_ASSERT=1&& vitest run apps/server/src/engine/bots/brains/passive/tight-passive-heatmap.test.ts apps/server/src/engine/bots/brains/aggressive/loose-aggressive-heatmap.test.ts apps/server/src/engine/bots/brains/passive/loose-passive-heatmap.test.ts",
    "test:server:soak": "vitest run apps/server/src/tests/integration/dealer.random-walk.soak.test.ts",
    "test:server:soak:nightly": "set SOAK_PROFILE=nightly&& vitest run apps/server/src/tests/integration/dealer.random-walk.soak.test.ts",
    "test:server:rejoin": "vitest run apps/server/src/rooms/session-policy.test.ts apps/server/src/rooms/table-join.guard.test.ts apps/server/src/rooms/table-action-broadcast.test.ts apps/server/src/engine/invariants/reconnection.invariant.test.ts apps/server/src/engine/dealer/services/player-lifecycle.removal-bet-sync.test.ts apps/server/src/engine/dealer/services/fold-path-equivalence.test.ts",
    "test:server:core": "pnpm test:server:join && pnpm test:server:broadcast && pnpm test:server:money-safety && pnpm test:server:money-invariants && pnpm test:server:fuzz:ci && pnpm test:server:lessons",
    "lint": "pnpm -C apps/client lint",
    "typecheck": "pnpm -C apps/client typecheck",
    "start": "node dist/apps/server/src/index.js",
    "start:with-seed": "pnpm db:migrate && pnpm lessons:seed:content && pnpm start",
    "start:web": "node tools/static-server.js",
    "db:migrate": "prisma migrate deploy",
    "server:typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "realtime:check": "pnpm -C packages/realtime-contract typecheck && pnpm server:typecheck && pnpm -C apps/client typecheck",
    "harness:headless": "tsx scripts/headless-two-client.ts",
    "harness:headless:churn": "tsx scripts/headless-multiplayer-churn.ts",
    "repro:run": "tsx scripts/churn-repro-run.ts",
    "repro:scan": "tsx scripts/churn-repro-scan.ts",
    "harness:headless:churn:nightly": "tsx scripts/headless-multiplayer-churn.ts --scenario=endurance --hands=40 --iterations=3 --invariant-mode=collect",
    "verify:churn:pr": "pnpm test:server:churn:matrix && pnpm test:server:churn:integration",
    "verify:churn:pre-release": "pnpm verify:churn:pr && pnpm exec tsx scripts/headless-multiplayer-churn.ts --scenario=endurance --hands=20 --iterations=1 && pnpm test:client:e2e:churn",
    "verify:churn:nightly": "pnpm verify:churn:pr && pnpm harness:headless:churn:nightly && pnpm test:client:e2e:churn",
    "phase5:auto": "tsx scripts/phase5-automated-gate.ts",
    "admin:make": "node scripts/make-admin.js",
    "reconcile:hand-history": "tsx scripts/reconcile-hand-history.ts",
    "bankroll:backfill": "tsx scripts/backfill-starting-bankroll.ts",
    "bankroll:backfill:apply": "tsx scripts/backfill-starting-bankroll.ts --apply",
    "lessons:seed:legacy": "tsx scripts/seed-lessons-v1.ts",
    "lessons:cleanup:legacy": "tsx scripts/cleanup-legacy-lessons.ts",
    "lessons:cleanup:legacy:apply": "tsx scripts/cleanup-legacy-lessons.ts --apply",
    "lessons:guard:legacy-seed": "node scripts/guard-no-legacy-seed.mjs",
    "lessons:seed:content": "tsx scripts/seed-lessons-content.ts",
    "lessons:smoke": "tsx scripts/smoke-lessons-v1.ts",
    "lessons:verify:runtime": "tsx scripts/verify-lessons-runtime.ts",
    "lessons:seed:integrity": "tsx scripts/check-lessons-seed-integrity.ts",
    "lessons:gate": "pnpm lessons:guard:legacy-seed && pnpm lessons:seed:content -- --replace-noncanonical && pnpm lessons:smoke && pnpm test:server:lessons && pnpm -C apps/client typecheck && pnpm -C apps/client run e2e:lessons",
    "lessons:export:replay": "tsx scripts/export-lesson-from-replay.ts",
    "lessons:list-replay-hands": "tsx scripts/list-hands-with-replay.ts",
    "lessons:export:auto": "tsx scripts/export-lessons-auto.ts",
    "lessons:build:from-spec": "tsx scripts/build-lesson-from-spec.ts",
    "lessons:build:all-specs": "tsx scripts/build-all-lessons-from-specs.ts",
    "lessons:validate": "tsx scripts/validate-lessons.ts",
    "lessons:content:check": "tsx scripts/check-lessons-content.ts",
    "lessons:import:prepare": "tsx scripts/prepare-lessons-json-import.ts",
    "lessons:import:apply-grading-plan": "tsx scripts/apply-grading-plan-to-drafts.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "sdk:gen": "pnpm openapi:export && node scripts/sync-sdk-version.mjs && npx openapi-typescript openapi.json -o packages/sdk/src/types.gen.ts",
    "sdk:check": "pnpm sdk:gen && pnpm -C packages/sdk typecheck",
    "card:faces:gen": "tsx scripts/generate-card-face-packs.ts",
    "api:shapes:gen": "node scripts/generate-api-shapes-docs.mjs",
    "api:shapes:check": "node scripts/check-api-shapes.mjs",
    "api:shapes:serve": "pnpm api:shapes:gen && node tools/serve-api-shapes.mjs",
    "ui:no-fetch": "node scripts/check-no-ui-fetch.mjs",
    "knip": "knip",
    "madge": "madge --circular --extensions ts,tsx apps/server/src apps/client/src packages/sdk/src packages/realtime-contract/src",
    "depcheck": "depcruise apps/server/src --config dependency-cruiser.cjs",
    "verify": "pnpm sdk:check && pnpm api:shapes:check && pnpm test:client && pnpm test:client:money-safety && pnpm test:server:core && pnpm test:server:soak && pnpm realtime:check && pnpm harness:headless && pnpm ui:no-fetch && pnpm knip && pnpm madge && pnpm depcheck",
    "verify:ci": "pnpm verify && pnpm test:client:e2e:stack:ci",
    "test:all": "pnpm verify && pnpm test:voice && pnpm test:client:lessons && pnpm test:server:history && pnpm test:server:churn:matrix && pnpm test:server:churn:integration && pnpm test:server:bot:heatmap:assert && pnpm test:server:bot:heatmap:profiles:assert && pnpm test:server:rejoin && pnpm test:client:e2e:stack:ci && pnpm test:client:e2e:churn && pnpm test:client:e2e:lessons:canonical",
    "test:all:nightly": "pnpm test:all && pnpm test:server:soak:nightly && pnpm verify:churn:nightly"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.36",
    "@colyseus/schema": "^4.0.12",
    "@colyseus/ws-transport": "^0.17.9",
    "@poker-champ/realtime-contract": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "p-limit": "^3.1.0",
    "pino": "^10.3.1",
    "poker-odds-calculator": "^0.4.0",
    "pokersolver": "^2.1.4",
    "stripe": "^20.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "2.1.9",
    "dependency-cruiser": "^17.3.8",
    "eslint": "^10.0.2",
    "expo-haptics": "^15.0.8",
    "knip": "^5.84.1",
    "madge": "^8.0.0",
    "openapi-typescript": "^7.13.0",
    "prisma": "5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^2.1.9"
  }
}
