{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts",
        "scripts/*.ts",
        "src/engine/seats/TableSeatSessionService.ts",
        "src/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "apps/client": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "app/**/+*.{ts,tsx}",
        "src/**/*.test.ts",
        "e2e/**/*.spec.ts"
      ],
      "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "e2e/**/*.ts"]
    },
    "packages/sdk": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/realtime-contract": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreUnresolved": ["babel-preset-expo", "expo-router/entry"],
  "ignoreBinaries": ["eas", "playwright"],
  "ignoreDependencies": [
    "@vitest/coverage-v8",
    "expo-updates",
    "expo-system-ui",
    "@babel/runtime",
    "react-native-css-interop"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/engine/dealer/utils/TableNavigator.ts": ["exports"],
    "apps/client/src/components/base/Icons.tsx": ["exports"],
    "apps/client/src/components/domain/table/PlayingCard.tsx": ["exports"],
    "apps/client/src/lib/sound.ts": ["exports"],
    "apps/client/src/registry/sound.registry.ts": ["exports"],
    "apps/client/src/realtime/transport.ts": ["exports"],
    "apps/client/src/theme/colors.ts": ["exports"],
    "apps/client/src/registry/service.registry.ts": ["types"],
    "apps/client/src/types/replayController.ts": ["types"],
    "apps/client/src/contexts/LessonRuntimeContext.tsx": ["exports"],
    "apps/client/src/hooks/useGameTableProvider.ts": ["exports"],
    "apps/client/src/hooks/useLessonTableProvider.ts": ["exports"],
    "apps/client/src/components/lesson/LessonPanel.tsx": ["exports"],
    "apps/client/src/content/blog/blog.types.ts": ["exports"],
    "apps/client/src/lib/lessons/lessonEvaluator.ts": ["exports"],
    "apps/client/src/lib/lessons/lessonSnapshots.ts": ["exports"],
    "apps/client/src/components/domain/table/loading/TableLoadingGraphic.tsx": ["exports"],
    "apps/client/src/features/replay/community/communityHands.ts": ["exports"],
    "apps/client/src/features/table-page/TablePage.tsx": ["exports"],
    "apps/client/src/assets/cards/generated/cardPackRegistry.ts": ["exports"]
  }
}

